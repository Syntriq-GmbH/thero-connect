{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Syntriq-GmbH/thero-connect/protocol/v1/messages.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/enroll"
    },
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/users"
    },
    {
      "$ref": "#/$defs/rights"
    },
    {
      "$ref": "#/$defs/done"
    },
    {
      "$ref": "#/$defs/renew"
    },
    {
      "$ref": "#/$defs/enrolled"
    },
    {
      "$ref": "#/$defs/welcome"
    },
    {
      "$ref": "#/$defs/walk"
    },
    {
      "$ref": "#/$defs/principals"
    },
    {
      "$ref": "#/$defs/access"
    },
    {
      "$ref": "#/$defs/read"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/renewed"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "requestId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "root": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^/\\\\:*?\"<>|\\u0000-\\u001f]+(/[^/\\\\:*?\"<>|\\u0000-\\u001f]+)*$"
    },
    "file": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "class": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "sid": {
      "type": "string",
      "pattern": "^S-1-[0-9]+(-[0-9]+)+$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[^A-Z]*$"
    },
    "machineId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^([0-9a-f]{16}-[0-9]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pem": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^-----BEGIN CERTIFICATE( REQUEST)?-----\\n"
    },
    "code": {
      "enum": [
        "bad_request",
        "version",
        "enroll",
        "renew",
        "cursor",
        "not_found",
        "changed",
        "busy",
        "limit",
        "denied",
        "unsupported",
        "unavailable",
        "failed"
      ]
    },
    "version": {
      "const": 1
    },
    "machine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "enroll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "token",
        "csr",
        "machine",
        "client"
      ],
      "properties": {
        "type": {
          "const": "enroll"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "csr": {
          "$ref": "#/$defs/pem"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "client": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "client",
        "machine",
        "roots"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "client": {
          "$ref": "#/$defs/client"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/root"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "cursor",
        "entries",
        "incomplete"
      ],
      "properties": {
        "type": {
          "const": "page"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "file",
              "size",
              "created",
              "modified",
              "class"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "file": {
                "$ref": "#/$defs/file"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "created": {
                "$ref": "#/$defs/time"
              },
              "modified": {
                "$ref": "#/$defs/time"
              },
              "class": {
                "$ref": "#/$defs/class"
              }
            }
          }
        },
        "incomplete": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "users"
      ],
      "properties": {
        "type": {
          "const": "users"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "email",
              "sid",
              "guid",
              "upn",
              "mail",
              "enabled",
              "ambiguous"
            ],
            "properties": {
              "email": {
                "$ref": "#/$defs/email"
              },
              "sid": {
                "$ref": "#/$defs/sid"
              },
              "guid": {
                "$ref": "#/$defs/guid"
              },
              "upn": {
                "type": "string",
                "maxLength": 1024
              },
              "mail": {
                "type": "string",
                "maxLength": 1024
              },
              "enabled": {
                "type": "boolean"
              },
              "ambiguous": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "classes",
        "errors"
      ],
      "properties": {
        "type": {
          "const": "rights"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "readers"
            ],
            "properties": {
              "class": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "readers": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 1000,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "code"
            ],
            "properties": {
              "root": {
                "$ref": "#/$defs/root"
              },
              "code": {
                "enum": [
                  "denied",
                  "not_found",
                  "unsupported",
                  "unavailable",
                  "failed"
                ]
              }
            }
          }
        }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "sha256"
      ],
      "properties": {
        "type": {
          "const": "done"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "renew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "csr"
      ],
      "properties": {
        "type": {
          "const": "renew"
        },
        "csr": {
          "$ref": "#/$defs/pem"
        }
      }
    },
    "enrolled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "machine",
        "cert",
        "ca"
      ],
      "properties": {
        "type": {
          "const": "enrolled"
        },
        "machine": {
          "$ref": "#/$defs/machineId"
        },
        "cert": {
          "$ref": "#/$defs/pem"
        },
        "ca": {
          "$ref": "#/$defs/pem"
        }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "welcome"
        }
      }
    },
    "walk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "root",
        "cursor"
      ],
      "properties": {
        "type": {
          "const": "walk"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "root": {
          "$ref": "#/$defs/root"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      }
    },
    "principals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "emails"
      ],
      "properties": {
        "type": {
          "const": "principals"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "emails": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/email"
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "sids"
      ],
      "properties": {
        "type": {
          "const": "access"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "sids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sid"
          }
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "root",
        "path",
        "file",
        "size",
        "modified"
      ],
      "properties": {
        "type": {
          "const": "read"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "root": {
          "$ref": "#/$defs/root"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "bytes"
      ],
      "properties": {
        "type": {
          "const": "ack"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "cancel"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "renewed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cert"
      ],
      "properties": {
        "type": {
          "const": "renewed"
        },
        "cert": {
          "$ref": "#/$defs/pem"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
